# Copie ce fichier en "keystore.properties" (dans le même dossier android/) et remplis-le.
# keystore.properties est ignoré par git : NE LE COMMITE JAMAIS.
#
# storeFile : chemin ABSOLU vers ton .jks, de préférence HORS du dépôt
# (ex: C:/Users/Dell 3050/standa-keys/standa-upload.jks). Slashs "/" même sous Windows.
storeFile=C:/Users/Dell 3050/standa-keys/standa-upload.jks
storePassword=CHANGE_MOI
keyAlias=standa-upload
keyPassword=CHANGE_MOI
