# Copiez ce fichier sous le nom .env.local, puis remplissez les valeurs localement.
# Ne placez jamais une clé réelle dans ce fichier ni dans GitHub.

# Supabase — valeurs publiques utilisables par le navigateur.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — serveur uniquement. Ces valeurs doivent rester vides dans ce modèle.
SUPABASE_SECRET_KEY=

# Administration — serveur uniquement.
SETUP_SECRET=

# Chiffrement PII (téléphone/adresse client, lib/pii-crypto.ts) — serveur uniquement.
# 64 caractères hex (32 octets). Générez avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Ne PERDEZ jamais cette clé une fois des données chiffrées avec : gardez
# une copie hors Vercel (coffre de l'entreprise). La perdre = données illisibles.
PII_ENCRYPTION_KEY=

# CORS (lib/cors.ts) — origine EXACTE de l'extension Chrome MCPACK autorisée
# à appeler /api/ingest et /api/ingest-conduce (ex: chrome-extension://abcdef...).
# Laissez vide tant que l'extension n'est pas publiée : ces routes restent
# protégées par le token Bearer même sans CORS.
ALLOWED_EXTENSION_ORIGIN=

# Notifications e-mail — serveur uniquement.
RESEND_API_KEY=
EMAIL_FROM="STANDA COMMERCIAL <notifications@example.com>"

# Notifications push (espace client) — générez une paire avec :
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY est envoyée au navigateur (normal, c'est la
# partie publique du protocole Web Push). VAPID_PRIVATE_KEY reste secrète,
# serveur uniquement — ne la placez jamais dans du code client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:notifications@standacommercialsa.com"

# Notifications push NATIVES (app Android/Uptodown) — serveur uniquement.
# Le Web Push ci-dessus ne fonctionne pas de façon fiable dans le WebView
# de l'APK (pas de service en arrière-plan quand l'app est fermée) : on
# passe par Firebase Cloud Messaging à la place.
#   1. console.firebase.google.com -> créer un projet -> Ajouter une app
#      Android -> nom de package EXACT : com.standacommercialsa.app
#      -> télécharger google-services.json -> le placer dans android/app/
#      (ce fichier n'est PAS un secret, il peut être commité).
#   2. Paramètres du projet -> Comptes de service -> Générer une nouvelle
#      clé privée -> coller tout le contenu du fichier JSON obtenu ici,
#      sur UNE seule ligne (ceci EST un secret — jamais dans android/app/,
#      jamais commité, uniquement dans Vercel > Environment Variables).
FIREBASE_SERVICE_ACCOUNT_JSON=
