# Copiez ce fichier sous le nom .env.local, puis remplissez les valeurs localement.
# Ne placez jamais une clé réelle dans ce fichier ni dans GitHub.

# Supabase — valeurs publiques utilisables par le navigateur.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — serveur uniquement. Ces valeurs doivent rester vides dans ce modèle.
SUPABASE_SECRET_KEY=

# Administration — serveur uniquement.
SETUP_SECRET=

# Notifications e-mail — serveur uniquement.
RESEND_API_KEY=
EMAIL_FROM="STANDA COMMERCIAL <notifications@example.com>"
